# Maintainer: snailsomi <snailsomi@gmail.com>
#
# Зависимости — ТОЛЬКО из официальных репозиториев Arch (CLAUDE.md,
# §Зависимости). Ни одного пакета из AUR. Известно, что plotext и ptpython в
# официальных репозиториях отсутствуют, поэтому графики рисуются своими
# виджетами Textual, а REPL — на модулях стандартной библиотеки.

pkgname=module-sim
pkgver=0.2.0
pkgrel=1
pkgdesc="Терминальная idle-игра: симулятор энергокомпании с атомной станцией"
arch=('any')
url="https://github.com/AkioArai/Module"
license=('MIT')

depends=(
  'python'
  'python-textual'
  'python-rich'
  'python-msgpack'
  'python-platformdirs'
)

makedepends=(
  'python-build'
  'python-installer'
  'python-hatchling'
  'python-wheel'
)

checkdepends=(
  'python-pytest'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# Не SKIP: контрольная сумма — единственное, что отличает «скачал релиз» от
# «скачал то, что подсунули». Обновляется вместе с pkgver.
sha256sums=('d348c4f3eb22a46f9698facc5568afaf081e9a5efab351c05cff040c7beb4c0c')

build() {
  cd "$srcdir/Module-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$srcdir/Module-$pkgver"
  # Бенчмарк догона пропускаем: на машине сборщика он мерит не тот код, а
  # загруженность сборочного узла. Всё остальное, включая цепочку миграций,
  # прогоняется обязательно.
  PYTHONPATH="$PWD" pytest -q -m "not slow"
}

package() {
  cd "$srcdir/Module-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CLAUDE.md "$pkgdir/usr/share/doc/$pkgname/CLAUDE.md"
  for doc in docs/*.md; do
    install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/$doc"
  done
}
