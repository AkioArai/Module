# Сейвы разработчика. Фикстуры в tests/fixtures/saves/ — наоборот, в git
# обязательно: без них нечем проверять, что обновление не теряет прогресс.
save.json
save.json.*
meta.json

# Мусор makepkg. Сам PKGBUILD в git обязательно, а собранное им — нет:
# пакет и распакованные исходники весят мегабайты и пересобираются одной
# командой.
packaging/pkg/
packaging/src/
packaging/*.pkg.tar.zst
packaging/*.tar.gz
